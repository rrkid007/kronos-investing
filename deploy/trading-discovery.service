[Unit]
Description=Trading platform weekly watchlist discovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=trading
WorkingDirectory=/opt/trading
EnvironmentFile=-/etc/trading-platform.env
ExecStart=/usr/local/bin/uv run python scripts/discover_stocks.py
# ~60 candidates x (download + fundamentals); generous ceiling.
TimeoutStartSec=1800
Nice=10
