[Unit]
Description=Trading platform weekly watchlist discovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rkidney
Group=rkidney
WorkingDirectory=/opt/trading
EnvironmentFile=-/opt/trading/.env
ExecStart=/opt/trading/.venv/bin/python scripts/discover_stocks.py
# ~60 candidates x (download + fundamentals); generous ceiling.
TimeoutStartSec=1800
Nice=10
